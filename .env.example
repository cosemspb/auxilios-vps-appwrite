# Configuration
# Copie este arquivo para .env.local e preencha com seus valores reais

# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.seudominio.org
NEXT_PUBLIC_APPWRITE_PROJECT_ID=seu_project_id_aqui
APPWRITE_API_KEY=sua_api_key_aqui
APPWRITE_DATABASE_ID=seu_database_id_aqui

# App URL (usada em links de emails, callback, etc)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Criptografia da senha SMTP (AES-256, gere uma chave segreta)
SMTP_ENCRYPTION_KEY=sua_chave_de_32_bytes_aqui

# Cloudflare R2 (armazenamento de arquivos e backups)
R2_ACCOUNT_ID=seu_account_id_aqui
R2_ACCESS_KEY_ID=sua_access_key_aqui
R2_SECRET_ACCESS_KEY=sua_secret_key_aqui
R2_BUCKET_NAME=nome_do_bucket
R2_PUBLIC_URL=https://pub-seuhash.r2.dev

# Reset de banco (ativar apenas quando for usar)
ALLOW_DB_RESET=false
